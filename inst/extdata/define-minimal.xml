<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="define2-1.xsl"?>
<!--
  A minimal but conforming Define-XML 2.1 document, shipped so that artoo's
  examples and vignettes have something real to validate and read without a
  network round trip. It carries one dataset, three variables, one codelist
  and one comment: enough to exercise every required element, small enough to
  read end to end. Not a submission artefact.
-->
<ODM xmlns="http://www.cdisc.org/ns/odm/v1.3"
     xmlns:def="http://www.cdisc.org/ns/def/v2.1"
     xmlns:xlink="http://www.w3.org/1999/xlink"
     ODMVersion="1.3.2"
     FileType="Snapshot"
     FileOID="artoo.define-minimal"
     CreationDateTime="2020-01-01T00:00:00"
     def:Context="Other">
  <Study OID="STDY.ARTOO.MINIMAL">
    <GlobalVariables>
      <StudyName>ARTOO-MINIMAL</StudyName>
      <StudyDescription>Minimal example study bundled with artoo</StudyDescription>
      <ProtocolName>ARTOO-MINIMAL</ProtocolName>
    </GlobalVariables>
    <MetaDataVersion OID="MDV.ARTOO.MINIMAL"
                     Name="Minimal example, Define-XML 2.1"
                     def:DefineVersion="2.1.0">
      <def:Standards>
        <def:Standard OID="STD.1" Name="SDTMIG" Type="IG" Version="3.4" Status="Final"/>
        <def:Standard OID="STD.2" Name="CDISC/NCI" Type="CT" PublishingSet="SDTM"
                      Version="2023-12-15" Status="Final"/>
      </def:Standards>
      <ItemGroupDef OID="IG.DM" Name="DM" Domain="DM" SASDatasetName="DM"
                    Repeating="No" IsReferenceData="No" Purpose="Tabulation"
                    def:Structure="One record per subject"
                    def:StandardOID="STD.1"
                    def:ArchiveLocationID="LF.DM">
        <Description>
          <TranslatedText xml:lang="en">Demographics</TranslatedText>
        </Description>
        <ItemRef ItemOID="IT.DM.STUDYID" OrderNumber="1" Mandatory="Yes" KeySequence="1"/>
        <ItemRef ItemOID="IT.DM.USUBJID" OrderNumber="2" Mandatory="Yes" KeySequence="2"/>
        <ItemRef ItemOID="IT.DM.SEX" OrderNumber="3" Mandatory="Yes"/>
        <def:Class Name="SPECIAL PURPOSE"/>
        <def:leaf ID="LF.DM" xlink:href="dm.xpt">
          <def:title>dm.xpt</def:title>
        </def:leaf>
      </ItemGroupDef>
      <ItemDef OID="IT.DM.STUDYID" Name="STUDYID" DataType="text" Length="20"
               SASFieldName="STUDYID">
        <Description>
          <TranslatedText xml:lang="en">Study Identifier</TranslatedText>
        </Description>
        <def:Origin Type="Protocol" Source="Sponsor"/>
      </ItemDef>
      <ItemDef OID="IT.DM.USUBJID" Name="USUBJID" DataType="text" Length="30"
               SASFieldName="USUBJID">
        <Description>
          <TranslatedText xml:lang="en">Unique Subject Identifier</TranslatedText>
        </Description>
        <def:Origin Type="Derived"/>
      </ItemDef>
      <ItemDef OID="IT.DM.SEX" Name="SEX" DataType="text" Length="1"
               SASFieldName="SEX" def:CommentOID="COM.SEX">
        <Description>
          <TranslatedText xml:lang="en">Sex</TranslatedText>
        </Description>
        <CodeListRef CodeListOID="CL.SEX"/>
        <def:Origin Type="Collected" Source="Investigator"/>
      </ItemDef>
      <CodeList OID="CL.SEX" Name="Sex" DataType="text" SASFormatName="$SEX"
                def:StandardOID="STD.2">
        <CodeListItem CodedValue="F" OrderNumber="1">
          <Decode><TranslatedText xml:lang="en">Female</TranslatedText></Decode>
          <Alias Context="nci:ExtCodeID" Name="C16576"/>
        </CodeListItem>
        <CodeListItem CodedValue="M" OrderNumber="2">
          <Decode><TranslatedText xml:lang="en">Male</TranslatedText></Decode>
          <Alias Context="nci:ExtCodeID" Name="C20197"/>
        </CodeListItem>
        <Alias Context="nci:ExtCodeID" Name="C66731"/>
      </CodeList>
      <def:CommentDef OID="COM.SEX">
        <Description>
          <TranslatedText xml:lang="en">Collected on the demography page.</TranslatedText>
        </Description>
      </def:CommentDef>
    </MetaDataVersion>
  </Study>
</ODM>
