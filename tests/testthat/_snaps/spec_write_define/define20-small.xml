    <MetaDataVersion OID="MDV.ARTOO-01" Name="SDTMIG 3.4 Data Definitions" def:DefineVersion="2.0.0" def:StandardName="SDTMIG" def:StandardVersion="3.4">
      <def:ValueListDef OID="VL.VS.VSORRES">
        <ItemRef ItemOID="IT.VS.VSORRES.WC.VS.HEIGHT.CM" OrderNumber="1" Mandatory="Yes">
          <def:WhereClauseRef WhereClauseOID="WC.VS.HEIGHT.CM"/>
        </ItemRef>
      </def:ValueListDef>
      <def:WhereClauseDef OID="WC.VS.HEIGHT.CM">
        <RangeCheck Comparator="EQ" SoftHard="Soft" def:ItemOID="IT.VS.VSTESTCD">
          <CheckValue>HEIGHT</CheckValue>
        </RangeCheck>
        <RangeCheck Comparator="IN" SoftHard="Soft" def:ItemOID="IT.VS.VSORRESU">
          <CheckValue>cm</CheckValue>
        </RangeCheck>
      </def:WhereClauseDef>
      <ItemGroupDef OID="IG.DM" Name="DM" Domain="DM" Repeating="No" SASDatasetName="DM" Purpose="Tabulation" def:Structure="One record per subject" def:Class="SPECIAL PURPOSE" def:ArchiveLocationID="LF.dm">
        <Description>
          <TranslatedText xml:lang="en">Demographics</TranslatedText>
        </Description>
        <ItemRef ItemOID="IT.DM.STUDYID" OrderNumber="1" Mandatory="Yes" KeySequence="1"/>
        <ItemRef ItemOID="IT.DM.USUBJID" OrderNumber="2" Mandatory="Yes" KeySequence="2" MethodOID="MT.USUBJID"/>
        <ItemRef ItemOID="IT.DM.SEX" OrderNumber="3" Mandatory="No"/>
        <ItemRef ItemOID="IT.DM.AGE" OrderNumber="4" Mandatory="No"/>
        <ItemRef ItemOID="IT.DM.COUNTRY" OrderNumber="5" Mandatory="No"/>
        <def:leaf ID="LF.dm" xlink:href="dm.xpt">
          <def:title>dm.xpt</def:title>
        </def:leaf>
      </ItemGroupDef>
      <ItemGroupDef OID="IG.VS" Name="VS" Domain="VS" Repeating="Yes" SASDatasetName="VS" Purpose="Tabulation" def:Structure="One record per STUDYID, USUBJID, VSTESTCD, VSSEQ" def:Class="FINDINGS" def:ArchiveLocationID="LF.VS">
        <Description>
          <TranslatedText xml:lang="en">Vital Signs</TranslatedText>
        </Description>
        <ItemRef ItemOID="IT.VS.STUDYID" OrderNumber="1" Mandatory="Yes" KeySequence="1"/>
        <ItemRef ItemOID="IT.VS.USUBJID" OrderNumber="2" Mandatory="Yes" KeySequence="2" MethodOID="MT.USUBJID"/>
        <ItemRef ItemOID="IT.VS.VSSEQ" OrderNumber="3" Mandatory="Yes" KeySequence="4"/>
        <ItemRef ItemOID="IT.VS.VSTESTCD" OrderNumber="4" Mandatory="Yes" KeySequence="3"/>
        <ItemRef ItemOID="IT.VS.VSORRES" OrderNumber="5" Mandatory="No"/>
        <ItemRef ItemOID="IT.VS.VSORRESU" OrderNumber="6" Mandatory="No"/>
        <ItemRef ItemOID="IT.VS.VSDTC" OrderNumber="7" Mandatory="No"/>
        <def:leaf ID="LF.VS" xlink:href="vs.xpt">
          <def:title>vs.xpt</def:title>
        </def:leaf>
      </ItemGroupDef>
      <ItemDef OID="IT.DM.STUDYID" Name="STUDYID" DataType="text" Length="20">
        <Description>
          <TranslatedText xml:lang="en">Study Identifier</TranslatedText>
        </Description>
        <def:Origin Type="Protocol"/>
      </ItemDef>
      <ItemDef OID="IT.DM.USUBJID" Name="USUBJID" DataType="text" Length="30">
        <Description>
          <TranslatedText xml:lang="en">Unique Subject Identifier</TranslatedText>
        </Description>
        <def:Origin Type="Derived"/>
      </ItemDef>
      <ItemDef OID="IT.DM.SEX" Name="SEX" DataType="text" Length="1" def:CommentOID="COM.SEX">
