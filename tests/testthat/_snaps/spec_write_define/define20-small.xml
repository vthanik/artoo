        </Description>
        <def:Origin Type="CRF"/>
      </ItemDef>
      <ItemDef OID="IT.VS.STUDYID" Name="STUDYID" DataType="text" Length="20">
        <Description>
          <TranslatedText xml:lang="en">Study Identifier</TranslatedText>
        </Description>
        <def:Origin Type="Protocol"/>
      </ItemDef>
