        </Description>
        <def:Origin Type="CRF"/>
      </ItemDef>
      <CodeList OID="CL.SEX" Name="Sex" DataType="text">
        <CodeListItem CodedValue="F" OrderNumber="1">
          <Decode>
            <TranslatedText xml:lang="en">Female</TranslatedText>
          </Decode>
          <Alias Context="nci:ExtCodeID" Name="C16576"/>
        </CodeListItem>
        <CodeListItem CodedValue="M" OrderNumber="2">
          <Decode>
            <TranslatedText xml:lang="en">Male</TranslatedText>
          </Decode>
          <Alias Context="nci:ExtCodeID" Name="C20197"/>
        </CodeListItem>
        <Alias Context="nci:ExtCodeID" Name="C66731"/>
      </CodeList>
      <MethodDef OID="MT.USUBJID" Name="Derive USUBJID" Type="Computation">
        <Description>
          <TranslatedText xml:lang="en">Concatenate STUDYID and SUBJID.</TranslatedText>
        </Description>
        <FormalExpression Context="SAS">usubjid = catx('-', studyid, subjid);</FormalExpression>
      </MethodDef>
      <def:CommentDef OID="COM.SEX">
        <Description>
          <TranslatedText xml:lang="en">Sex is collected once at screening.</TranslatedText>
        </Description>
